
<!DOCTYPE html>
<html>
<head>
<title>Dark Mode</title>
<style>
body {
background: white;
color: black;
text-align: center;
}
.dark {
background: #222;
color: white;
}
button {
padding: 10px;
background: blue;
color: white;
}
</style>
</head>
<body>
<h2>Dark Mode Implementation</h2>
<p>Welcome to my webpage!</p>
<button onclick="changeMode()">Toggle Dark Mode</button>
<script>
function changeMode() {
document.body.classList.toggle("dark");
}
</script>
</body>
</html>
